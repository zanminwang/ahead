{
  "expo": {
    "name": "Ahead To-do",
    "slug": "ahead-todo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.ahead.Todo",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      "../../../packages/client-react-native/plugins/expo-path-spaces.cjs"
    ]
  }
}
