{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/client-js/*.mts",
    "packages/server/*.mts",
    "packages/persistence-prisma/*.mts",
    "integration/e2e/fixtures/round-trip/*.mts",
    "examples/todo/*.mts"
  ]
}
