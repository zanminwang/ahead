generator client {
  provider = "prisma-client-js"
  output = "./client"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id
  name String
  todos Todo[]
}
model Todo {
  id String @id
  title String
  done Boolean
  createdById String
  createdBy User @relation(fields: [createdById], references: [id])
}
